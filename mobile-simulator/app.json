{
  "expo": {
    "name": "SURGE Simulator",
    "slug": "surge-simulator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0c1a0c"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SURGE needs your location to simulate dustbin/truck GPS tracking."
      }
    },
    "android": {
      "package": "com.sbuvanesh.surgesimulator",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0c1a0c"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "SURGE Simulator needs your location to simulate IoT device tracking."
        }
      ],
      "expo-asset"
    ]
  }
}
